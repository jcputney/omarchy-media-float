#!/usr/bin/env bash
# twitch-float — browse Twitch and play a stream in the floating, pinned overlay
# that follows you across every Hyprland workspace.
#
#   twitch-float auth            one-time device-code sign-in
#   twitch-float browse          live follows, then categories / top / search
#   twitch-float play <login>    play a specific channel
#   twitch-float quality <q>     720p60 | best | toggle (restarts the stream)
#
# Hide/show, resize and close are shared with the other overlays: see
# `float-overlay`.
#
# Config: ~/.config/twitch-float/config    TWITCH_CLIENT_ID=...
# Tokens: ~/.config/twitch-float/tokens    (written by `auth`, mode 0600)

set -euo pipefail

SELF="$(readlink -f "$0")"
APP_ID="TwitchFloat"
OVERLAY_APP_NAME="Twitch"
# The overlay picker is this tool's own Omarchy plugin. Absent or
# disabled, the menus fall back to ghostty+fzf.
: "${FLOAT_PICKER_PLUGIN_ID:=io.github.jcputney.media-float-twitch}"
export FLOAT_PICKER_PLUGIN_ID
# shellcheck source=/dev/null
source "$HOME/.local/lib/float-overlay.sh"

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/twitch-float"
CONFIG="$CONFIG_DIR/config"
TOKENS="$CONFIG_DIR/tokens"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/twitch-float"
MENU="$CACHE_DIR/menu.tsv"
CHANNEL_FILE="$RUN_DIR/twitch-channel"
QUALITY_FILE="$CONFIG_DIR/quality"
LANGUAGE_FILE="$CONFIG_DIR/language"

SCOPES="user:read:follows"
DEFAULT_QUALITY="720p60,720p,best"

mkdir -p "$CONFIG_DIR" "$CACHE_DIR"

# The client ID this tool is registered under. A Twitch client ID is a public
# identifier -- it is sent to Twitch on every request a browser makes -- so it
# ships here rather than making everyone register their own app. The app is
# registered Public, so sign-in is the device flow and there is no client secret
# anywhere in this tool. Override it in the config to use your own registration.
DEFAULT_CLIENT_ID="b9wf8ty2oka25ics0gduepoq9kssch"

load_config() {
  # Shell-shaped because that is what people expect to write, read as text
  # because reading a file is not a reason to run it.
  local id=""
  [[ -f $CONFIG ]] && id="$(conf_value "$CONFIG" TWITCH_CLIENT_ID || true)"
  TWITCH_CLIENT_ID="${id:-${TWITCH_CLIENT_ID:-$DEFAULT_CLIENT_ID}}"
  [[ -n $TWITCH_CLIENT_ID ]] || die "TWITCH_CLIENT_ID is empty; set it in $CONFIG"
  # It is not a secret, but it is a header value and a form field all the same.
  valid_token "$TWITCH_CLIENT_ID" || die "TWITCH_CLIENT_ID is not a Client ID; check $CONFIG"
}

# ── The token file ──────────────────────────────────────────────────────────
# It used to be shell syntax that ensure_token ran with `source`, built by
# interpolating an OAuth response straight in. A value with a newline or a
# metacharacter in it was therefore a command, and the expiry went into shell
# arithmetic, which evaluates too. JSON is data: jq writes it with everything
# quoted, and reading it back never executes anything.
#
# Storing it safely is only half of it. These values go on to be interpolated
# into curl config syntax, where a quote or a newline would close the value and
# begin a fresh directive attached to a request already carrying the
# credential. Nothing is escaped for that: a token is checked against the shape
# a real one has, and refused if it does not fit.

save_tokens() { # save_tokens <access> <refresh> <expires_in>
  local expires_in refresh
  expires_in="$(num_or "${3:-}" 3600)"
  valid_token "${1:-}" || die "Twitch returned an access token in an unexpected form"
  # A refresh token is optional. An unusable one is dropped rather than stored,
  # so the next run asks for a fresh sign-in instead of feeding it to curl.
  refresh="${2:-}"
  valid_token "$refresh" || refresh=""
  jq -n --arg a "$1" --arg r "$refresh" \
        --argjson e "$(( $(date +%s) + expires_in ))" \
        '{access: $a, refresh: $r, expires: $e}' | private_write "$TOKENS"
}

# A file written before 0.8.2 is the old shell format. It is read as text —
# never sourced, which was the bug — and rewritten as JSON, so signing in again
# is not needed.
migrate_tokens() {
  [[ -s $TOKENS ]] || return 1
  private_read "$TOKENS" 2>/dev/null | jq -e 'type == "object"' >/dev/null 2>&1 \
    && return 0
  local a r e
  a="$(conf_value "$TOKENS" TWITCH_ACCESS_TOKEN || true)"
  r="$(conf_value "$TOKENS" TWITCH_REFRESH_TOKEN || true)"
  e="$(conf_value "$TOKENS" TWITCH_TOKEN_EXPIRES || true)"
  valid_token "$a" || return 1
  valid_token "$r" || r=""
  e="$(num_or "$e" 0)"
  jq -n --arg a "$a" --arg r "$r" --argjson e "$e" \
        '{access: $a, refresh: $r, expires: $e}' | private_write "$TOKENS"
}

load_tokens() {
  migrate_tokens || return 1
  local j; j="$(private_read "$TOKENS" 2>/dev/null || true)"
  jq -e 'type == "object"' <<< "${j:-}" >/dev/null 2>&1 || return 1
  TWITCH_ACCESS_TOKEN="$(jq -r '.access  // empty' <<< "$j")"
  TWITCH_REFRESH_TOKEN="$(jq -r '.refresh // empty' <<< "$j")"
  TWITCH_TOKEN_EXPIRES="$(num_or "$(jq -r '.expires // 0' <<< "$j")" 0)"
  # A stored value still has to be usable before it is put anywhere. Anything
  # that fails here is treated as not being signed in.
  valid_token "$TWITCH_ACCESS_TOKEN" || return 1
  valid_token "$TWITCH_REFRESH_TOKEN" || TWITCH_REFRESH_TOKEN=""
  return 0
}

# ── Auth (device code flow) ─────────────────────────────────────────────────
# Public client: no client secret anywhere, including on refresh.

cmd_auth() {
  load_config
  local resp device_code user_code verify interval expires waited token err

  resp="$(printf 'data-urlencode = "scopes=%s"\n' "$SCOPES" | oauth_post /device)" || true
  [[ -n $resp ]] \
    || die "Could not start device authorization — is the Client ID right, and the app set to Public?"

  # The device code goes into a curl config, the verification address goes to
  # a browser, and the two counts go into shell arithmetic and a sleep. None of
  # them is trusted for being in the response.
  device_code="$(jq -r '.device_code // empty' <<< "$resp")"
  valid_token "$device_code" || die "Twitch returned a device code in an unexpected form"
  user_code="$(safe_text "$(jq -r '.user_code // empty' <<< "$resp")")"
  verify="$(jq -r '.verification_uri // empty' <<< "$resp")"
  host_allowed "$verify" twitch.tv \
    || die "Twitch pointed the sign-in somewhere unexpected, so it was not opened"
  interval="$(num_or "$(jq -r '.interval // 5' <<< "$resp")" 5)"
  expires="$(num_or "$(jq -r '.expires_in // 1800' <<< "$resp")" 1800)"

  printf '\n  Open:  %s\n  Code:  %s\n\n  Waiting for you to approve…\n\n' "$verify" "$user_code"
  note "Enter code $user_code at $verify"
  command -v xdg-open >/dev/null && setsid -f xdg-open "$verify" >/dev/null 2>&1 || true

  waited=0
  while (( waited < expires )); do
    sleep "$interval"
    waited=$(( waited + interval ))
    resp="$(printf 'data-urlencode = "device_code=%s"\ndata-urlencode = "grant_type=urn:ietf:params:oauth:grant-type:device_code"\n' \
      "$device_code" | oauth_post /token)" || continue
    token="$(jq -r '.access_token // empty' <<< "$resp")"
    if [[ -n $token ]]; then
      save_tokens "$token" \
        "$(jq -r '.refresh_token // empty' <<< "$resp")" \
        "$(jq -r '.expires_in // 3600' <<< "$resp")"
      printf '  Signed in. Tokens written to %s\n\n' "$TOKENS"
      note "Signed in to Twitch"
      return 0
    fi
    err="$(jq -r '.message // .error // empty' <<< "$resp")"
    # authorization_pending is the normal "not approved yet" answer.
    case "$err" in
      *pending*|*"slow down"*|"") ;;
      *) die "Sign-in failed: $err" ;;
    esac
  done
  die "Sign-in timed out — run: twitch-float auth"
}

# ── Talking to Twitch ───────────────────────────────────────────────────────
# Anything on a command line is readable from /proc by any process running as
# this user, for as long as the request takes. So the secret-bearing pieces —
# the refresh token, the device code, the bearer header — go in as a curl config
# on stdin instead. printf is a shell builtin, so writing that config never
# forks a process whose arguments could be read either.
#
# Every call is bounded: a connect deadline, a total deadline, and a byte
# ceiling enforced while the body arrives rather than after it is buffered.

oauth_post() { # oauth_post <path>; secret form fields arrive on stdin
  local API_MAX_BYTES=1048576
  curl -sS -K - \
    --connect-timeout "$FETCH_CONNECT_TIMEOUT" \
    --max-time "$FETCH_MAX_TIME" \
    --max-filesize "$API_MAX_BYTES" \
    -X POST "https://id.twitch.tv/oauth2$1" \
    --data-urlencode "client_id=$TWITCH_CLIENT_ID" 2>/dev/null \
  | head -c "$API_MAX_BYTES"
}

ensure_token() {
  load_config
  [[ -f $TOKENS ]] || die "Not signed in. Run: twitch-float auth"
  load_tokens || die "Not signed in. Run: twitch-float auth"

  # Refresh a minute before expiry so a long browse never dies mid-request.
  if (( $(date +%s) >= ${TWITCH_TOKEN_EXPIRES:-0} - 60 )); then
    local resp token
    [[ -n ${TWITCH_REFRESH_TOKEN:-} ]] || die "Session expired. Run: twitch-float auth"
    resp="$(printf 'data-urlencode = "grant_type=refresh_token"\ndata-urlencode = "refresh_token=%s"\n' \
      "$TWITCH_REFRESH_TOKEN" | oauth_post /token)" || true
    token="$(jq -r '.access_token // empty' <<< "${resp:-}")"
    [[ -n $token ]] || die "Session expired. Run: twitch-float auth"
    save_tokens "$token" \
      "$(jq -r '.refresh_token // empty' <<< "$resp")" \
      "$(jq -r '.expires_in // 3600' <<< "$resp")"
    TWITCH_ACCESS_TOKEN="$token"
  fi
}

helix() { # helix <path-with-query>
  local API_MAX_BYTES=4194304
  valid_token "${TWITCH_ACCESS_TOKEN:?}" \
    || die "The saved Twitch token is not in a form this can use — run: twitch-float auth"
  printf 'header = "Authorization: Bearer %s"\n' "$TWITCH_ACCESS_TOKEN" \
  | curl -fsS -K - \
      --connect-timeout "$FETCH_CONNECT_TIMEOUT" \
      --max-time 20 \
      --max-filesize "$API_MAX_BYTES" \
      -H "Client-Id: $TWITCH_CLIENT_ID" \
      "https://api.twitch.tv/helix$1" \
  | head -c "$API_MAX_BYTES"
}

# Twitch serves every image — stream previews, box art, avatars — from one CDN,
# and a preview for a stream that just went offline redirects to a placeholder
# on that same host, so redirects have to be followed rather than refused. This
# is asked again about every hop, so following one cannot leave the CDN.
fetch_guard() { # fetch_guard <url>
  host_allowed "${1:-}" static-cdn.jtvnw.net
}

resolve_image() { # resolve_image <url>; echoes a local file
  cache_image "${1:-}"
}

user_id() {
  local f="$CACHE_DIR/user_id"
  if [[ -s $f ]]; then cat "$f"; return 0; fi
  local id
  id="$(helix /users | jq -r '.data[0].id // empty')"
  [[ -n $id ]] || die "Could not read your Twitch account — try: twitch-float auth"
  printf '%s\n' "$id" | tee "$f"
}

# ── Menus ──────────────────────────────────────────────────────────────────
# Rows: <display> \t <thumbnail-url> \t <info> \t <action> \t <value>
# The whole navigation runs inside one picker window; tui_* functions are the
# parts that execute there.

jq_stream_rows='
  def viewers: if . >= 1000 then ((. / 100 | floor) / 10 | tostring) + "k" else tostring end;
  def clean: (. // "") | gsub("[\t\n\r]"; " ");
  .data[]?
  | ((now - (.started_at | fromdateiso8601)) | floor) as $up
  | (.title | clean) as $ttl
  | [ "●  " + (.user_name // .user_login)
        + "   —   " + (if (.game_name // "") == "" then "?" else .game_name end)
        + "   ·  " + (.viewer_count // 0 | viewers),
      (.thumbnail_url // "-" | sub("\\{width\\}"; "640") | sub("\\{height\\}"; "360")),
      ([ (.user_name // .user_login),
         (if (.game_name // "") == "" then "?" else .game_name end),
         ( [ (.viewer_count // 0 | tostring) + " viewers",
             "live " + ($up / 3600 | floor | tostring) + "h "
                     + (($up % 3600) / 60 | floor | tostring) + "m",
             (if (.language // "") != "" then (.language | ascii_upcase) else null end),
             (if (.is_mature // false) then "18+" else null end)
           ] | map(select(. != null)) | join("  ·  ") ),
         (if ((.tags // []) | length) > 0
          then ((.tags // []) | join(", ")) else null end)
       ] | map(select(. != null and . != "")) | join("\u001f")
       | . + "\u001f\u001f" + $ttl),
      "play",
      .user_login ]
  | @tsv'

# ── Language filter ─────────────────────────────────────────────────────────
# Helix filters /streams by language server-side, so the top list and every
# category honour it for free. /search/channels ignores the parameter, so that
# one is filtered here on broadcaster_language instead.
#
# Your own follows are deliberately exempt. Following someone is a stronger
# signal than a language preference, and hiding a channel you chose to follow
# because it streams in another language would be a bug, not a filter.

# Twitch reports stream language as ISO 639-1. This is the set it actually
# populates in volume, not the whole standard.
LANGUAGES='any:Any language
en:English
es:Spanish
pt:Portuguese
fr:French
de:German
it:Italian
ru:Russian
ja:Japanese
ko:Korean
zh:Chinese
th:Thai
tr:Turkish
pl:Polish
nl:Dutch
sv:Swedish
da:Danish
no:Norwegian
fi:Finnish
cs:Czech
hu:Hungarian
el:Greek
ar:Arabic
he:Hebrew
id:Indonesian
vi:Vietnamese
hi:Hindi
uk:Ukrainian
ro:Romanian
ca:Catalan'

language() { cat "$LANGUAGE_FILE" 2>/dev/null || echo any; }

language_name() { # language_name <code>
  local n
  n="$(printf '%s\n' "$LANGUAGES" | awk -F: -v c="${1:-any}" '$1 == c { print $2 }')"
  printf '%s' "${n:-$1}"
}

# Appended to a /streams query. Empty when the filter is off, so the URL is
# unchanged from before this existed.
lang_q() {
  local l; l="$(language)"
  [[ $l == any ]] && return 0
  printf '&language=%s' "$l"
}

language_rows() {
  local cur; cur="$(language)"
  printf '%s\n' "$LANGUAGES" | while IFS=: read -r code name; do
    [[ -n $code ]] || continue
    printf '%s  %s\t-\t%s\u001f\u001fStreams tagged %s.\tsetlang\t%s\n' \
      "$([[ $code == "$cur" ]] && printf '●' || printf ' ')" \
      "$name" "$name" "$name" "$code"
  done
}

live_follows() { helix "/streams/followed?user_id=$(user_id)&first=100" | jq -r "$jq_stream_rows"; }

nav_row() { printf '%s\t-\t%s\t%s\t%s\n' "$1" "$2" "$3" "$4"; }

tui_main_rows() {
  live_follows
  nav_row "🔍  Search channels…"             "Search Twitch for a channel by name." menu search
  nav_row "🎮  Search categories…"           "Search Twitch for a game or category, then pick a stream." menu gamesearch
  nav_row "📂  Browse categories…"           "Pick a game or category, then a stream." menu categories
  nav_row "🔥  Top streams right now"        "The biggest live streams on Twitch." menu top
  nav_row "👥  All followed (incl. offline)" "Every channel you follow, live or not." menu follows
  nav_row "🌐  Language: $(language_name "$(language)")" \
    "Filters top streams and categories. Search is filtered too. Your own follows are always shown, whatever they stream in." \
    menu language
}

# Each level writes its own rows file, so stepping back re-reads what was
# already fetched instead of asking Twitch for it again.
menu_file() { printf '%s/menu-%s.tsv' "$CACHE_DIR" "$1"; }

# Where the picker was when you chose a channel. Every level's rows are already
# on disk, so remembering the labels is enough to walk back into them.
MENU_STATE="$CACHE_DIR/menu-state"
RESUME_FILE="$CONFIG_DIR/resume"

resume_enabled() { [[ "$(cat "$RESUME_FILE" 2>/dev/null || echo on)" == on ]]; }

save_menu_state() { printf '%s\n' "${labels[@]}" > "$MENU_STATE"; }

# Only restore a stack whose every level still has its rows. A half-present
# stack would open on a level you cannot back out of.
restore_menu_state() {
  [[ -s $MENU_STATE ]] || return 0
  local -a saved=(); local d
  mapfile -t saved < "$MENU_STATE"
  (( ${#saved[@]} > 0 )) || return 0
  for (( d = 0; d < ${#saved[@]}; d++ )); do
    [[ -s "$(menu_file "$d")" ]] || return 0
  done
  labels=("${saved[@]}")
}

tui_submenu_rows() { # tui_submenu_rows <which>; writes rows to stdout
  case "$1" in
    search)
      local q; q="$(ask "Search Twitch…")"
      [[ -n $q ]] || return 1
      helix "/search/channels?live_only=true&first=50&query=$(printf %s "$q" | jq -sRr @uri)" \
        | jq -r --arg lang "$(language)" '
            def clean: (. // "") | gsub("[\t\n\r]"; " ");
            .data[]?
            | select($lang == "any" or (.broadcaster_language // "") == $lang)
            | [ "●  " + (.display_name // .broadcaster_login)
                  + "   —   " + (if (.game_name // "") == "" then "?" else .game_name end),
                (.thumbnail_url // "-"),
                ((.display_name // .broadcaster_login) + "\u001f"
                  + (if (.game_name // "") == "" then "?" else .game_name end)
                  + "\u001f\u001f" + (.title | clean)),
                "play", .broadcaster_login ] | @tsv'
      ;;
    gamesearch)
      local gq; gq="$(ask "Search categories…")"
      [[ -n $gq ]] || return 1
      helix "/search/categories?first=100&query=$(printf %s "$gq" | jq -sRr @uri)" | jq -r '
        .data[]? | [ "📂  " + .name,
                     (.box_art_url // "-" | sub("\\{width\\}"; "285") | sub("\\{height\\}"; "380")),
                     .name, "game", .id, .name ] | @tsv'
      ;;
    categories)
      helix "/games/top?first=100" | jq -r '
        .data[]? | [ "📂  " + .name,
                     (.box_art_url // "-" | sub("\\{width\\}"; "285") | sub("\\{height\\}"; "380")),
                     .name, "game", .id, .name ] | @tsv'
      ;;
    language) language_rows ;;
    top)     helix "/streams?first=100$(lang_q)" | jq -r "$jq_stream_rows" ;;
    follows)
      helix "/channels/followed?user_id=$(user_id)&first=100" \
        | jq -r '.data[]? | [ "   " + .broadcaster_name, "-",
                              (.broadcaster_name + "\u001f\u001fFollowed channel. Offline channels cannot be played."),
                              "play", .broadcaster_login ] | @tsv'
      ;;
  esac
}

submenu_label() { # submenu_label <which>; the prompt shown for that level
  case "$1" in
    language)   printf 'Twitch · language' ;;
    search)     printf 'Twitch · channel search' ;;
    gamesearch) printf 'Twitch · category search' ;;
    categories) printf 'Twitch · categories' ;;
    top)        printf 'Twitch · top' ;;
    follows)    printf 'Twitch · followed' ;;
    game)       printf 'Twitch · %s' "${2:-category}" ;;
    *)          printf 'Twitch' ;;
  esac
}

# The menu is a stack of levels rather than nested calls, so Escape and the
# "← Back" row pop one instead of tearing the whole thing down. Only the top
# level has nowhere above it: Escape closes there.
cmd_browse_tui() {
  ensure_token
  local -a labels=()
  local depth picked action value extra rows f

  [[ ${TWF_RESUME:-0} == 1 ]] && restore_menu_state
  if (( ${#labels[@]} == 0 )); then
    tui_main_rows > "$(menu_file 0)"
    labels=("Twitch")
  fi

  while (( ${#labels[@]} > 0 )); do
    depth=$(( ${#labels[@]} - 1 ))
    f="$(menu_file "$depth")"
    [[ -s $f ]] || { unset "labels[$depth]"; continue; }

    if (( depth > 0 )); then
      picked="$(pick "$f" "${labels[$depth]}" back)" || return 1
    else
      picked="$(pick "$f" "${labels[$depth]}")" || return 1
    fi

    if [[ -z $picked ]] || is_back "$picked"; then
      (( depth == 0 )) && return 1
      unset "labels[$depth]"
      continue
    fi

    IFS=$'\t' read -r action value extra <<< "$picked"
    case "$action" in
      play) save_menu_state; emit "$value"; return 0 ;;
      setlang)
        # The choice changes what every level would show, so save it and
        # collapse back to the first screen rather than leaving stale rows
        # further up the stack.
        ( umask 077; printf '%s\n' "$value" > "$LANGUAGE_FILE" )
        tui_main_rows > "$(menu_file 0)"
        labels=("Twitch")
        ;;
      menu)
        rows="$(tui_submenu_rows "$value")" || continue
        [[ -n $rows ]] || continue
        { back_row; printf '%s\n' "$rows"; } > "$(menu_file $(( depth + 1 )))"
        labels+=("$(submenu_label "$value")")
        ;;
      game)
        rows="$(helix "/streams?game_id=$value&first=100$(lang_q)" | jq -r "$jq_stream_rows")"
        [[ -n $rows ]] || continue
        { back_row; printf '%s\n' "$rows"; } > "$(menu_file $(( depth + 1 )))"
        labels+=("$(submenu_label game "${extra:-$value}")")
        ;;
    esac
  done
}

cmd_browse() { # cmd_browse [--resume]
  local login
  [[ ${1:-} == --resume ]] && export TWF_RESUME=1
  login="$(run_menu "$SELF _browse_tui")"
  [[ -n $login ]] || exit 0
  ensure_token
  start_stream "$login" browse
}

# ── Playback ────────────────────────────────────────────────────────────────

# A stream selector becomes a streamlink argument, so it is checked on the way
# in and on the way out. Being alphanumeric is not enough: `status` is a
# perfectly ordinary word and a meaningless stream, and a file holding one is
# how a mistyped command becomes a stream that will not start.
valid_quality() { # valid_quality <selector-list>
  local q="${1:-}" part
  [[ -n $q && ${#q} -le 64 ]] || return 1
  local IFS=,
  for part in $q; do
    [[ $part =~ ^(best|worst|audio_only|[0-9]{3,4}p[0-9]{0,3})$ ]] || return 1
  done
  return 0
}

quality() {
  local q; q="$(cat "$QUALITY_FILE" 2>/dev/null | head -1 || true)"
  valid_quality "$q" && printf '%s' "$q" || printf '%s' "$DEFAULT_QUALITY"
}

start_stream() { # start_stream <login> [browse]
  [[ -n ${1:-} ]] || exit 0
  # It goes into a Helix query string and into the address streamlink opens.
  # A Twitch login is letters, digits and underscores; anything else is not a
  # channel, whatever the API said.
  [[ $1 =~ ^[A-Za-z0-9_]{1,32}$ ]] || die "Not a Twitch channel name: $1"
  # Offline channels are reachable from the "All followed" list, and streamlink
  # simply finds no streams and exits, leaving no window and no explanation.
  # Ask Helix first so there is something to say.
  [[ -n "$(helix "/streams?user_login=$1" | jq -r '.data[0].id // empty')" ]] \
    || die "$1 is not live right now"
  stop_existing
  printf '%s\n' "$1" > "$CHANNEL_FILE"
  setsid -f "$0" _session "$1" "${2:-}" >> "$LOG" 2>&1
  note "Opening $1…"
}

cmd_session() { # cmd_session <login> [browse]
  local login="$1" from="${2:-}" mpv_pid
  [[ $login =~ ^[A-Za-z0-9_]{1,32}$ ]] || die "Not a Twitch channel name: $login"
  echo "$$" > "$PID_FILE"
  # setsid gives this session its own process group, so killing the group on the
  # way out takes streamlink with it.
  trap 'trap - EXIT; rm -f "$PID_FILE"; kill -- "-$$" 2>/dev/null || true' EXIT

  overlay_mpv_args "$APP_ID" "$login on Twitch"
  rm -f "$SOCKET"

  # streamlink handles the Twitch HLS and drops ad segments; mpv just plays the
  # bytes off the pipe. A live stream is not seekable, which is fine here.
  local err="$RUN_DIR/streamlink.err" started
  started="$(date +%s)"
  streamlink --twitch-disable-ads --stdout \
    "https://twitch.tv/$login" "$(quality)" 2>"$err" \
    | mpv "${OVERLAY_MPV_ARGS[@]}" - >/dev/null 2>&1 &
  mpv_pid=$!

  overlay_apply_size_when_ready
  wait "$mpv_pid" || true

  # Dying within a few seconds means it never really started; surface why.
  if (( $(date +%s) - started < 10 )); then
    note "$(grep -m1 -i "error" "$err" 2>/dev/null || echo "$login stopped unexpectedly")"
  fi

  # Back to the picker, where you left it. Only reached when the stream ended
  # or you closed it: opening another channel kills this session's process
  # group first, so a superseded session never gets here.
  if [[ $from == browse ]] && resume_enabled; then
    setsid -f "$0" browse --resume >/dev/null 2>&1 || true
  fi
}

cmd_quality() {
  ensure_token
  local want="${1:-toggle}" cur
  cur="$(quality)"
  case "$want" in
    toggle) if [[ $cur == best ]]; then want="$DEFAULT_QUALITY"; else want=best; fi ;;
    source) want=best ;;
  esac
  valid_quality "$want" \
    || die "Not a stream quality: $want (try best, source, 720p, 720p60, or a comma-separated list)"
  printf '%s\n' "$want" > "$QUALITY_FILE"
  note "Quality: $want"
  # Restart the current channel so the change takes effect now — but only if the
  # overlay on screen is actually a Twitch stream, not a Plex one.
  if [[ -s $CHANNEL_FILE && "$(overlay_field .class)" == "$APP_ID" ]]; then
    start_stream "$(cat "$CHANNEL_FILE")"
  fi
}

cmd_resume() { # cmd_resume <on|off|status>
  case "${1:-status}" in
    on|off)
      ( umask 077; mkdir -p "$CONFIG_DIR"; printf '%s\n' "$1" > "$RESUME_FILE" )
      note "Reopen the picker after a stream: $1"
      ;;
    status) printf 'Reopen the picker after a stream: %s\n' \
              "$(cat "$RESUME_FILE" 2>/dev/null || echo on)" ;;
    *) die "Usage: twitch-float resume <on|off|status>" ;;
  esac
}

cmd_language() { # cmd_language [code|any|--list]
  local want="${1:---list}"
  if [[ $want == --list ]]; then
    printf 'Language filter: %s\n\n' "$(language_name "$(language)")"
    printf '%s\n' "$LANGUAGES" | while IFS=: read -r code name; do
      printf '  %s %-6s %s\n' \
        "$([[ $code == "$(language)" ]] && printf '*' || printf ' ')" "$code" "$name"
    done
    return 0
  fi
  printf '%s\n' "$LANGUAGES" | awk -F: -v c="$want" 'BEGIN{ok=1} $1 == c {ok=0} END{exit ok}' \
    || die "Unknown language: $want (try: twitch-float language --list)"
  load_config
  ( umask 077; mkdir -p "$CONFIG_DIR"; printf '%s\n' "$want" > "$LANGUAGE_FILE" )
  note "Language: $(language_name "$want")"
}

case "${1:-browse}" in
  auth)     cmd_auth ;;
  language) shift || true; cmd_language "${1:---list}" ;;
  resume)   shift || true; cmd_resume "${1:-status}" ;;
  browse)   shift || true; cmd_browse "${1:-}" ;;
  _browse_tui) cmd_browse_tui ;;
  _preview) shift || true; render_preview "${1:--}" "${2:--}" "${3:-}" ;;
  _thumb)   shift || true; resolve_image "${1:-}" ;;
  play)     shift; ensure_token; start_stream "${1:?channel login required}" ;;
  quality)  shift || true; cmd_quality "${1:-toggle}" ;;
  toggle)   cmd_toggle ;;
  quit)     cmd_quit ;;
  size)     shift || true; cmd_size "${1:-cycle}" ;;
  _session) shift; cmd_session "$1" "${2:-}" ;;
  *)        die "Unknown command: $1 (auth|browse|play|quality|language|resume|toggle|quit|size)" ;;
esac
